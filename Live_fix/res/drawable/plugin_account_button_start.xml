<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="4.0dip" />
            <solid android:color="@color/pa_transparent" />
            <stroke android:width="1.0dip" android:color="@color/pa_disabled" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="4.0dip" />
            <solid android:color="@color/pa_no_variation_highlight" />
            <stroke android:width="1.0dip" android:color="@color/primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="4.0dip" />
            <solid android:color="@color/pa_no_variation_highlight" />
            <stroke android:width="1.0dip" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4.0dip" />
            <solid android:color="@color/pa_white" />
            <stroke android:width="1.0dip" android:color="@color/primary" />
        </shape>
    </item>
</selector>