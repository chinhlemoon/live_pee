<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="oval">
            <solid android:color="#8a000000" />
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="0.0" android:toDegrees="1080.0" android:pivotX="50.0%" android:pivotY="50.0%">
            <shape android:shape="ring" android:innerRadiusRatio="4.0" android:thicknessRatio="10.0" android:useLevel="false">
                <gradient android:startColor="#ff000000" android:endColor="#ffffffff" android:useLevel="false" android:angle="0.0" android:type="sweep" android:centerY="0.5" />
            </shape>
        </rotate>
    </item>
</layer-list>