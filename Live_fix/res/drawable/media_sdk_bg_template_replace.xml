    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="4.0dip" />
            <stroke android:width="0.5dip" android:color="@color/media_sdk_pick_main_color" />
            <solid android:color="@color/media_sdk_FBFBFB" />
        </shape>
    </item>
</selector>