<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2.0dip" android:color="@color/transparent" />
                    <corners android:radius="7.0dip" />
                </shape>
            </item>
            <item android:left="4.0dip" android:top="4.0dip" android:right="4.0dip" android:bottom="4.0dip">
                <shape android:shape="rectangle">
                    <solid android:color="@color/media_sdk_text_font_bg" />
                    <corners android:radius="4.0dip" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2.0dip" android:color="@color/main_color" />
                    <corners android:radius="7.0dip" />
                </shape>
            </item>
            <item android:left="4.0dip" android:top="4.0dip" android:right="4.0dip" android:bottom="4.0dip">
                <shape android:shape="rectangle">
                    <solid android:color="@color/media_sdk_text_font_bg" />
                    <corners android:radius="4.0dip" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>