            <solid android:color="@color/p_brand_color_primary_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="@dimen/radius_dp_15" android:bottomRightRadius="@dimen/radius_dp_15" />
            <stroke android:width="@dimen/com_garena_beepay_border_width" android:color="@color/p_brand_color_primary" />
            <solid android:color="@color/p_brand_color_primary" />
        </shape>
    </item>
</selector>